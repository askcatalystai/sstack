-function card(t, showProject) {
+const PROVIDERS = ["codex", "claude", "cursor", "opencode", "codex-bot", "local"];
+const EFFORTS = ["low", "medium", "high", "xhigh", "max", "fastmode-off"];
+
+function cardLabel(tag) {
+  if (PROVIDERS.includes(tag)) return { order: 0, className: `label provider-${tag}`, glyph: tag };
+  if (/^(gpt-|claude-|composer-|deepseek|muse|sid-gate|chatgpt-codex-connector)/.test(tag)) {
+    return { order: 1, className: "label label-model" };
+  }
+  if (EFFORTS.includes(tag)) return { order: 2, className: `label effort-${tag}` };
+  if (/^(?:<1m|\d+d(?: \d+h)?(?: \d+m)?|\d+h(?: \d+m)?|\d+m)$/.test(tag)) {
+    return { order: 3, className: "label label-elapsed" };
+  }
+  if (tag === "stale") return { order: 3, className: "label label-stale" };
+  if (tag === "new-comment") return { order: 4, className: "label label-comment", text: "new comment" };
+  return { order: 4, className: "" };
+}
+
+function card(t) {
+  const pr = t.tags.find((tag) => /^pr-\d+$/.test(tag));
+  const labels = t.tags.filter((tag) => !/^pr-\d+$/.test(tag))
+    .map((tag) => ({ tag, ...cardLabel(tag) }))
+    .sort((a, b) => a.order - b.order);
   const node = el("div", { class: "card" + (state.task === t.id ? " open" : ""), draggable: "true", "data-id": t.id,
                            onclick: () => openTask(t.id) },
     el("div", { class: "head" },
       el("div", { class: "title" }, t.title),
-      // On "All projects" a dot in the project's colour tells the projects apart.
       t.human ? el("span", { class: "human-mark", title: "Human task: agents skip it" }, icon("human")) : null,
-      el("span", { class: "num", title: `Copy ${key(t)}`, onclick: (e) => { e.stopPropagation(); copyKey(key(t)); } },
-        showProject ? el("span", { class: "dot", style: `background:${projectColor(t.project)}` }) : null, `#${t.id}`)),
+      pr ? el("span", { class: "num", title: `Pull request #${pr.slice(3)}` }, `#${pr.slice(3)}`) : null),
     t.description ? el("div", { class: "desc" }, plainText(t.description)) : null,
-    t.tags.length ? el("div", { class: "tags" }, t.tags.map((tag) => el("span", { class: "tag" }, tag))) : null);
+    labels.length ? el("div", { class: "tags" }, labels.map((label) =>
+      el("span", { class: `tag ${label.className}` }, label.glyph ? icon(label.glyph) : null, label.text || label.tag))) : null);
   node.addEventListener("dragstart", (e) => {
     state.dragging = t.id;
     e.dataTransfer.effectAllowed = "move";
@@ -1295,32 +1321,13 @@ async function checkUpdate() {
   } catch {}
 }
 
-function showUpdate({ current, available }) {
-  const button = $("#update");
-  button.hidden = !available;
-  if (!available) return;
-  $("#update-label").textContent = `Update to ${available}`;
-  button.title = `You have ${current}`;
-  button.onclick = () => {
-    if (confirm(`Update Kanzo from ${current} to ${available}? The board restarts, which takes a few seconds.`)) installUpdate(available);
-  };
+function showUpdate() {
+  // Keep the upstream update offer hidden on this local patched build.
+  $("#update").hidden = true;
 }
 
 async function checkForUpdates() {
-  toast("Checking for updates…");
-  try {
-    const status = await api("GET", "/update?now=1");
-    showUpdate(status);
-    if (status.available) {
-      if (confirm(`Kanzo ${status.available} is out (you have ${status.current}). Download and install it now? The board restarts.`)) {
-        installUpdate(status.available);
-      }
-    } else if (status.latest) {
-      toast(`Kanzo is up to date (${status.current})`);
-    } else {
-      toast("Can't reach GitHub to check for updates");
-    }
-  } catch (err) { toast(err.message); }
+  toast("This is a local patched build; automatic updates are disabled.");
 }
 
 async function installUpdate(available) {
