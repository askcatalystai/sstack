@@ -1303,13 +1303,28 @@ mod tests {
         assert_eq!(s.get_task(human.id).unwrap().status, "todo");
     }
 
+    #[test]
+    fn deployment_precedes_done_and_accepts_tasks() {
+        let (_dir, s) = store();
+        assert_eq!(s.statuses(), ["todo", "doing", "review", "deployment", "done"]);
+        assert_eq!(s.done_status(), "done");
+        let p = s.create_project("api", "", None).unwrap();
+        let t = s.create_task_in(p.id, Some("deployment"), "Ship it", "").unwrap();
+        assert_eq!(t.status, "deployment");
+        let t = s.update_task(t.id, TaskPatch { status: Some("review".into()), ..Default::default() }).unwrap();
+        assert_eq!(
+            s.update_task(t.id, TaskPatch { status: Some("deployment".into()), ..Default::default() }).unwrap().status,
+            "deployment"
+        );
+    }
+
     #[test]
